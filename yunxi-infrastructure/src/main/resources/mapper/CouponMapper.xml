<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yunxi.infrastructure.persistence.mapper.CouponMapper">

    <resultMap id="CouponResultMap"
               type="com.yunxi.infrastructure.persistence.po.CouponPO">
        <id     column="id"          property="id"/>
        <result column="name"        property="name"/>
        <result column="discount"    property="discount"/>
        <result column="total_stock" property="totalStock"/>
        <result column="start_time"  property="startTime"/>
        <result column="end_time"    property="endTime"/>
        <result column="status"      property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.yunxi.infrastructure.persistence.po.CouponPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO coupons (name, discount, total_stock, start_time, end_time, status)
        VALUES (#{name}, #{discount}, #{totalStock}, #{startTime}, #{endTime}, #{status})
    </insert>

    <select id="selectById" resultMap="CouponResultMap">
        SELECT * FROM coupons WHERE id = #{id}
    </select>

    <update id="updateStatus">
        UPDATE coupons SET status = #{status} WHERE id = #{id}
    </update>

</mapper>